# ---------------------------------------------------------------------------
# Advanced RAG — environment template
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Core services (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://rag:rag_dev_password@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks_v1

# Auth — create a workspace via `make create-workspace`; leave blank.
# RAG_BOOTSTRAP_API_KEY is only used by the explicit bootstrap command, never by the API.
RAG_BOOTSTRAP_API_KEY=

# Storage
DATA_DIR=./data
MAX_UPLOAD_BYTES=26214400
ALLOWED_URL_HOSTS=
URL_FETCH_TIMEOUT_SECONDS=15

# Embeddings: local | openai | ollama
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_ENABLED=true
# OpenAI-compatible embedding endpoint (when EMBEDDING_PROVIDER=openai)
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
# Ollama embeddings (when EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# LLM: ollama | openai | none
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
LLM_STREAMING=true

# Reranker: none | local
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TIMEOUT_SECONDS=15

# Retrieval defaults
RETRIEVAL_MODE=hybrid
DENSE_TOP_K=30
SPARSE_TOP_K=30
FUSION_TOP_K=20
RERANK_TOP_N=8
RRF_K=60
MIN_DENSE_SCORE=0.20
CONTEXT_TOKEN_BUDGET=3000
CHUNK_TARGET_TOKENS=384
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=48

# Admin
AUTH_RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_JOBS=2
INLINE_WORKER=true
